rules_version = '2';

// MyTruck Delivery — Firestore security rules
//
// Roles live on /user/{uid}.role: customer, pendingSeller, restaurant, shop,
// driver, mini_admin, superadmin. Cloud Functions use the Admin SDK and are not
// affected by these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity ──────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function profilePath() { return /databases/$(database)/documents/user/$(uid()); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function myRole() {
      let profileExists = hasProfile();
      let profile = profileExists ? me() : {};
      return profile.get('role', '');
    }

    function staffProfile(profile) {
      return profile.get('role', '') in ['superadmin', 'super_admin', 'admin', 'mini_admin', 'miniadmin'] ||
             profile.get('isAdmin', false) == true ||
             profile.get('isSuperAdmin', false) == true ||
             profile.get('isMiniAdmin', false) == true;
    }

    // Platform owner accounts (exact matches — mirrors utils/roles.js)
    function isOwnerAccount() {
      return signedIn() && request.auth.token.get('email', '') in [
        'superadmin@mytruck.et', 'admin@mytruck.et', '251911000001@login.mytruck.local'
      ];
    }
    function isStaff() {
      let profileExists = hasProfile();
      let profile = profileExists ? me() : {};
      return isOwnerAccount() || (profileExists && staffProfile(profile));
    }
    function isBlocked() {
      let profileExists = hasProfile();
      let profile = profileExists ? me() : {};
      let staff = isOwnerAccount() || (profileExists && staffProfile(profile));
      return profileExists && profile.get('accountStatus', '') in ['BANNED', 'SUSPENDED'] && !staff;
    }
    function isDriver() {
      let profileExists = hasProfile();
      let profile = profileExists ? me() : {};
      let staff = isOwnerAccount() || (profileExists && staffProfile(profile));
      let blocked = profileExists && profile.get('accountStatus', '') in ['BANNED', 'SUSPENDED'] && !staff;
      return profileExists && profile.get('role', '') == 'driver' && !blocked;
    }
    function isSeller() {
      let profileExists = hasProfile();
      let profile = profileExists ? me() : {};
      let staff = isOwnerAccount() || (profileExists && staffProfile(profile));
      let blocked = profileExists && profile.get('accountStatus', '') in ['BANNED', 'SUSPENDED'] && !staff;
      return profileExists && profile.get('role', '') in ['pendingSeller', 'restaurant', 'shop', 'seller'] && !blocked;
    }

    // A store id this account owns (same ids SellerHome queries with)
    function ownsStoreId(storeId) {
      let profileExists = hasProfile();
      let profile = profileExists ? me() : {};
      return storeId == uid() || (profileExists && (
        storeId == profile.get('sellerId', '~') ||
        storeId == profile.get('restaurantId', '~') ||
        storeId == profile.get('shopId', '~')));
    }
    function ownsStoreDoc(storeId) {
      let restaurantPath = /databases/$(database)/documents/restaurants/$(storeId);
      let shopPath = /databases/$(database)/documents/shops/$(storeId);
      let restaurantExists = exists(restaurantPath);
      let shopExists = exists(shopPath);
      return (restaurantExists && get(restaurantPath).data.get('ownerUid', '') == uid()) ||
             (shopExists && get(shopPath).data.get('ownerUid', '') == uid());
    }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changed().hasOnly(keys); }
    function onlyChangedKeys(changes, keys) { return changes.hasOnly(keys); }

    // ── User profiles (/user is primary, /users is a legacy mirror) ───────
    // Fields an account may never change about itself
    function protectedProfileKeys() {
      return ['role', 'isAdmin', 'isSuperAdmin', 'isMiniAdmin', 'accountStatus',
              'approvalStatus', 'isApproved', 'banReason', 'sellerId', 'restaurantId', 'shopId'];
    }
    function validNewProfile() {
      let d = request.resource.data;
      return d.get('role', 'customer') in ['customer', 'pendingSeller'] &&
             d.get('isAdmin', false) == false && d.get('isSuperAdmin', false) == false &&
             d.get('isMiniAdmin', false) == false &&
             !(d.get('accountStatus', '') in ['BANNED', 'SUSPENDED']) &&
             d.get('approvalStatus', 'PENDING') == 'PENDING' && d.get('isApproved', false) == false;
    }
    function safeSelfUpdate() {
      let oldRole = resource.data.get('role', '');
      let newRole = request.resource.data.get('role', '');
      let isSellerProfile = oldRole in ['pendingSeller', 'restaurant', 'shop', 'seller'];
      let locationKeys = ['address', 'city', 'latitude', 'longitude', 'storeLatitude', 'storeLongitude'];
      return !changed().hasAny(protectedProfileKeys().removeAll(['role'])) &&
             (!isSellerProfile || !changed().hasAny(locationKeys)) &&
             (newRole == oldRole ||
              (oldRole == '' && newRole == 'customer') ||
              (oldRole in ['', 'customer'] && newRole == 'pendingSeller'));
    }

    match /user/{userId} {
      allow get: if signedIn() && (userId == uid() || isStaff());
      // Own-email lookup (AuthContext fallback) and admin listing
      allow list: if isStaff() || (signedIn() && resource.data.get('email', '') == request.auth.token.email);
      allow create: if signedIn() && (isStaff() || (userId == uid() && (validNewProfile() || isOwnerAccount())));
      allow update: if signedIn() && (isStaff() || (userId == uid() && (safeSelfUpdate() || isOwnerAccount())));
      allow delete: if isStaff();

      match /deviceTokens/{tokenId} {
        allow read, write: if signedIn() && (userId == uid() || isStaff());
      }
    }
    match /users/{userId} {
      allow get: if signedIn() && (userId == uid() || isStaff());
      allow list: if isStaff() || (signedIn() && resource.data.get('email', '') == request.auth.token.email);
      allow create: if signedIn() && (isStaff() || (userId == uid() && (validNewProfile() || isOwnerAccount())));
      allow update: if signedIn() && (isStaff() || (userId == uid() && (safeSelfUpdate() || isOwnerAccount())));
      allow delete: if isStaff();

      match /deviceTokens/{tokenId} {
        allow read, write: if signedIn() && (userId == uid() || isStaff());
      }
    }

    match /drivers/{driverId} {
      allow read: if signedIn() && (driverId == uid() || isStaff());
      allow write: if signedIn() && ((driverId == uid() && isDriver()) || isStaff());
    }

    // ── Orders ────────────────────────────────────────────────────────────
    match /orders/{orderId} {
    // These helpers are scoped to an order document so Firestore binds
    // request.resource and resource to the current order update.
    function orderChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function isOrderCustomer() { return resource.data.userId == uid(); }
    function isOrderStore() {
      return resource.data.get('merchantOwnerUid', '') == uid() ||
             ownsStoreId(resource.data.get('restaurantId', '')) ||
             ownsStoreDoc(resource.data.get('restaurantId', ''));
    }
    function isOrderDriver() { return resource.data.get('driverId', null) == uid(); }

    function isPackageData(d) { return d.get('orderType', '') == 'PACKAGE'; }
    // Fee floors set by the Super Admin (platformSettings/config); 0 when not configured
    function platformCfg() {
      return exists(/databases/$(database)/documents/platformSettings/config)
        ? get(/databases/$(database)/documents/platformSettings/config).data
        : {};
    }
    function feesAtLeastPlatformMinimum(d) {
      let cfg = platformCfg();
      return d.deliveryFee >= (isPackageData(d)
               ? cfg.get('packageMinimumFee', 0)
               : cfg.get('minimumDeliveryFee', cfg.get('baseFee', 0))) &&
             d.serviceFee >= cfg.get('serviceFee', 0);
    }
    // Package (courier) orders have no store: zero items, no seller, placeholder store id
    function validPackageShape(d) {
      return d.subtotal == 0 &&
             d.get('merchantOwnerUid', null) == null &&
             d.restaurantId is string && d.restaurantId.matches('package_.*');
    }

    function validNewOrder() {
      let d = request.resource.data;
      return d.userId == uid() &&
             (isPackageData(d)
               // cash packages go straight to drivers; online-paid packages wait for payment
               ? validPackageShape(d) &&
                 ((d.status == 'READY' && d.paymentMethod == 'COD' && d.paymentStatus == 'PENDING') ||
                  (d.status == 'AWAITING_PAYMENT' && d.paymentMethod == 'CHAPA'))
               : d.status in ['PENDING', 'AWAITING_PAYMENT']) &&
             (d.get('paymentMethod', '') == 'CHAPA' || feesAtLeastPlatformMinimum(d)) &&
             d.paymentStatus in ['PENDING', 'UNPAID'] &&
             d.get('driverId', null) == null &&
             !('cashCollected' in d) && !('refundStatus' in d) && !('paidAt' in d) &&
             d.total is number && d.subtotal is number && d.deliveryFee is number && d.serviceFee is number &&
             d.deliveryFee >= 0 && d.serviceFee >= 0 && d.total >= 0 &&
             // total must add up (promo discount is the only reduction)
             math.abs(d.total - (d.subtotal + d.deliveryFee + d.serviceFee - d.get('promoDiscount', 0))) < 0.05;
    }

    // Customer: cancel before the store accepts (packages: before a driver takes it)
    function customerCancels() {
      return (resource.data.status in ['AWAITING_PAYMENT', 'PENDING', 'AWAITING_MERCHANT', 'MERCHANT_REJECTED'] ||
              (resource.data.status == 'READY' && isPackageData(resource.data))) &&
             resource.data.get('driverId', null) == null &&
             request.resource.data.status == 'CANCELLED' &&
             request.resource.data.paymentStatus == resource.data.paymentStatus &&
             onlyChangedKeys(orderChanged(), ['status', 'cancelledBy', 'cancelReason', 'cancelledAt',
                                         'refundStatus', 'refundAmount', 'updatedAt']) &&
             (!('refundStatus' in request.resource.data) || resource.data.paymentStatus == 'PAID');
    }

    // Reject server-owned payment mutations before evaluating the full set of
    // order actor rules. Admin SDK functions bypass these client rules.
    function chapaPaymentFieldsUnchanged() {
      return resource.data.get('paymentMethod', '') != 'CHAPA' ||
             !orderChanged().hasAny(['paymentStatus', 'paidAt', 'paymentInitiatedAt', 'chapaVerifiedAmount',
                                     'paymentVerifiedBy', 'chapaMerchantReference', 'chapaCheckoutUrl', 'total', 'currency']);
    }

    // Customers can only reach the customer-order branch for their own order.
    // Staff roles remain eligible through the separate staff branch.
    function customerOrderScope() {
      return !(hasProfile() && myRole() == 'customer' && !isStaff() && !isOrderCustomer());
    }

    // Store: accept / decline / prepare / ready, in order
    function storeAdvances() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      let hasDriver = resource.data.get('driverId', null) != null;
      return onlyChangedKeys(orderChanged(), ['status', 'acceptedAt', 'preparingAt', 'readyAt', 'dispatchStartedAt', 'updatedAt',
                                          'rejectedByMerchant', 'merchantRejectionReason', 'rejectedAt']) &&
             ((from in ['PENDING', 'AWAITING_MERCHANT'] && to in ['ACCEPTED', 'MERCHANT_REJECTED']) ||
              (from == 'ACCEPTED' && to == 'PREPARING') ||
              (from == 'PREPARING' && ((!hasDriver && to == 'READY') || (hasDriver && to == 'DRIVERACCEPTED'))));
    }

    // Driver actions
    function driverClaims() {
      let from = resource.data.status;
      let offerLive = resource.data.get('offeredDriverId', null) != null &&
                      resource.data.get('offerExpiresAt', null) != null &&
                      resource.data.offerExpiresAt > request.time;
      return resource.data.get('driverId', null) == null &&
             from in ['PREPARING', 'READY'] &&
             (!offerLive || resource.data.offeredDriverId == uid()) &&
             request.resource.data.driverId == uid() &&
             request.resource.data.status == (from == 'READY' ? 'DRIVERACCEPTED' : from) &&
             onlyChangedKeys(orderChanged(), ['driverId', 'driverName', 'driverPhone', 'status', 'driverAcceptedAt',
                                         'offeredDriverId', 'offerExpiresAt', 'updatedAt']);
    }
    function driverPassesOffer() {
      return resource.data.get('offeredDriverId', null) == uid() &&
             onlyChangedKeys(orderChanged(), ['offeredDriverId', 'offerExpiresAt', 'declinedDriverIds']);
    }
    function driverSharesLocation() {
      return onlyChangedKeys(orderChanged(), ['driverLat', 'driverLng', 'driverHeading', 'driverSpeed', 'driverLocationUpdatedAt']);
    }
    function driverPicksUp() {
      return resource.data.status in ['READY', 'DRIVERACCEPTED'] &&
             request.resource.data.status == 'DRIVERPICKEDUP' &&
             onlyChangedKeys(orderChanged(), ['status', 'pickedUpAt', 'updatedAt']);
    }
    function driverCompletes() {
      let cashOrder = resource.data.get('paymentMethod', '') != 'CHAPA';
      return resource.data.status == 'DRIVERPICKEDUP' &&
             request.resource.data.status == 'COMPLETE' &&
             onlyChangedKeys(orderChanged(), ['status', 'deliveredAt', 'updatedAt',
                                         'paymentStatus', 'cashCollected', 'cashCollectedAmount', 'paidAt']) &&
             // only a cash order can be marked paid by the driver
             (request.resource.data.paymentStatus == resource.data.paymentStatus ||
              (cashOrder && request.resource.data.paymentStatus == 'PAID'));
    }
    function driverReleases() {
      return resource.data.status in ['PREPARING', 'READY', 'DRIVERACCEPTED'] &&
             request.resource.data.get('driverId', null) == null &&
             request.resource.data.status == (resource.data.status == 'PREPARING' ? 'PREPARING' : 'READY') &&
             onlyChangedKeys(orderChanged(), ['status', 'driverId', 'driverName', 'driverPhone', 'driverLat', 'driverLng',
                                         'driverAcceptedAt', 'declinedDriverIds', 'dispatchStartedAt',
                                         'driverRejectedAt', 'driverRejectReason', 'updatedAt']);
    }

    // Staff may manage order operations, but payment authorization fields on a
    // Chapa order are server-only (Admin SDK bypasses these client rules).
    function staffOrderUpdate() {
      return isStaff();
    }

    function orderUpdateAllowed() {
      let profileExists = hasProfile();
      let profile = profileExists ? me() : {};
      let role = profile.get('role', '');
      let staff = isOwnerAccount() || (profileExists && staffProfile(profile));
      let blocked = profileExists && profile.get('accountStatus', '') in ['BANNED', 'SUSPENDED'] && !staff;
      let isCustomer = resource.data.get('userId', '') == uid();
      let isAssignedDriver = resource.data.get('driverId', null) == uid();
      return !blocked &&
        ((isCustomer && customerCancels()) ||
         staff ||
         ((resource.data.get('merchantOwnerUid', '') == uid() ||
           ownsStoreId(resource.data.get('restaurantId', '')) ||
           ownsStoreDoc(resource.data.get('restaurantId', ''))) &&
          role in ['pendingSeller', 'restaurant', 'shop', 'seller'] && storeAdvances()) ||
         (role == 'driver' && (driverClaims() || driverPassesOffer())) ||
         (isAssignedDriver && (driverSharesLocation() || driverPicksUp() || driverCompletes() || driverReleases())));
    }

      allow read: if signedIn() && (
        isStaff() ||
        isOrderCustomer() ||
        isOrderDriver() ||
        (isDriver() && resource.data.status in ['PREPARING', 'READY']) ||
        isOrderStore());
      allow create: if signedIn() && !isBlocked() && validNewOrder();
      // Run the small protected-payment guard before role, ownership, and
      // workflow predicates. Denied Chapa mutations should not evaluate the
      // large actor authorization tree at all.
      allow update: if signedIn() && chapaPaymentFieldsUnchanged() && orderUpdateAllowed();
      allow delete: if isStaff();
    }

    // Order line items: written in the same batch as the order
    match /orderDishes/{lineId} {
      allow read: if signedIn();
      allow create: if signedIn() && !isBlocked() &&
        getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == uid() &&
        (getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.get('paymentMethod', '') != 'CHAPA' ||
         !('chapaMerchantReference' in getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data));
      allow update, delete: if isStaff();
    }

    // ── Catalog ───────────────────────────────────────────────────────────
    function ownsItem() {
      return resource.data.get('ownerUid', '') == uid() || resource.data.get('sellerId', '') == uid();
    }
    function itemStaysUnapproved() {
      let d = request.resource.data;
      return d.get('isApproved', false) == false && d.get('status', 'PENDING') == 'PENDING' &&
             d.get('approvalStatus', 'PENDING') == 'PENDING' && d.get('isPublished', false) == false;
    }
    function approvalUntouched() {
      return !changed().hasAny(['isApproved', 'status', 'approvalStatus', 'isPublished', 'lifecycleStatus', 'isActive']);
    }

    match /dishes/{dishId} {
      allow read: if signedIn();
      allow create: if isStaff() ||
        (isSeller() && request.resource.data.get('ownerUid', '') == uid() && itemStaysUnapproved());
      // Edits go back to review; toggling availability keeps approval as-is
      allow update: if isStaff() ||
        (isSeller() && ownsItem() && request.resource.data.get('ownerUid', '') == uid() &&
         (approvalUntouched() || itemStaysUnapproved()));
      allow delete: if isStaff() || (isSeller() && ownsItem());
    }
    match /products/{productId} {
      allow read: if signedIn();
      allow create: if isStaff() ||
        (isSeller() && request.resource.data.get('ownerUid', '') == uid() && itemStaysUnapproved() &&
         request.resource.data.get('isActive', false) == false);
      allow update: if isStaff() ||
        (isSeller() && ownsItem() && request.resource.data.get('ownerUid', '') == uid() &&
         ((approvalUntouched()) || (itemStaysUnapproved() && request.resource.data.get('isActive', false) == false)));
      allow delete: if isStaff() || (isSeller() && ownsItem());
    }

    // Stores: created at seller sign-up as PENDING; owners edit storefront details only
    function newStoreValid() {
      let d = request.resource.data;
      return d.get('ownerUid', '') == uid() && d.get('status', '') == 'PENDING' && d.get('isVerified', false) == false;
    }
    function ownerEditsStorefront(storeId) {
      // New merchant documents have ownerUid; older/admin-created records may
      // be linked by the protected sellerId/restaurantId/shopId on the user's
      // own profile instead.
      return isSeller() &&
             (resource.data.get('ownerUid', '') == uid() || ownsStoreId(storeId)) &&
             onlyChanges(['workingHours', 'openingTime', 'closingTime', 'image', 'profileImage', 'logoUrl', 'updatedAt']);
    }
    function ownerSetsStoreAvailability(storeId) {
      return isSeller() &&
             resource.data.get('status', '') == 'APPROVED' &&
             (resource.data.get('ownerUid', '') == uid() || ownsStoreId(storeId)) &&
             onlyChanges(['isOpen', 'isAvailable', 'isTemporarilyClosed', 'updatedAt']);
    }
    match /restaurants/{storeId} {
      allow read: if signedIn();
      allow create: if isStaff() || (signedIn() && newStoreValid());
      allow update: if isStaff() || (signedIn() && !isBlocked() && (ownerEditsStorefront(storeId) || ownerSetsStoreAvailability(storeId)));
      allow delete: if isStaff();
    }
    match /shops/{storeId} {
      allow read: if signedIn();
      allow create: if isStaff() || (signedIn() && newStoreValid());
      allow update: if isStaff() || (signedIn() && !isBlocked() && (ownerEditsStorefront(storeId) || ownerSetsStoreAvailability(storeId)));
      allow delete: if isStaff();
    }

    match /sellerApplications/{appId} {
      allow create: if signedIn() && request.resource.data.get('ownerUid', '') == uid() &&
                       request.resource.data.get('status', '') == 'PENDING';
      allow read: if signedIn() && (isStaff() || resource.data.get('ownerUid', '') == uid());
      allow update, delete: if isStaff();
    }

    match /categories/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /platformSettings/{id} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ── Money ─────────────────────────────────────────────────────────────
    // Merchant settlement allocations. Verification records live in a separate
    // server-only collection and are written by Admin SDK functions.
    match /chapaPayments/{txRef} {
      allow read: if isSeller() || isStaff();
      allow create, update: if (isSeller() || isStaff()) &&
        request.resource.data.amount is number &&
        request.resource.data.allocations is map &&
        request.resource.data.txRef == txRef;
      allow delete: if isStaff();
    }

    match /driver_payouts/{payoutId} {
      allow read: if signedIn() && (isStaff() || resource.data.get('driverId', '') == uid());
      allow write: if isStaff();
    }

    // ── Notifications ─────────────────────────────────────────────────────
    match /notifications/{id} {
      allow create: if signedIn() && !isBlocked();
      allow read, update, delete: if signedIn() &&
        (isStaff() || resource.data.get('recipientUid', '') == uid());
    }
    match /deviceTokens/{tokenId} {
      allow create, update: if signedIn() && request.resource.data.get('uid', '') == uid();
      allow read, delete: if signedIn() && (isStaff() || resource.data.get('uid', '') == uid());
    }

    // ── Registered phone numbers (services/phoneIndex.js) ─────────────────
    // One document per number: /phoneIndex/2519XXXXXXXX -> { uid }. A single number can be looked up
    // without signing in, so sign-up can refuse a taken number BEFORE an SMS code is sent.
    // The list can't be browsed, and a number can only be reserved once.
    match /phoneIndex/{phone} {
      allow get: if true;
      allow list: if isStaff() || (signedIn() && resource.data.uid == uid());
      allow create: if signedIn() && phone.matches('^251[79][0-9]{8}$') && (isStaff() || (
        request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
        request.resource.data.uid == uid() &&
        hasProfile() && me().get('phoneNumber', '') == '+' + phone));
      allow update: if isStaff();
      allow delete: if isStaff() || (signedIn() && resource.data.uid == uid());
    }

    // ── Phone verification codes ──────────────────────────────────────────
    // Codes now live on the server (Supabase, table phone_otps). The app never reads or writes them.
    match /phoneOtpChallenges/{challengeId} {
      allow read, write: if false;
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
