EXPO_PUBLIC_FIREBASE_API_KEY=replace_with_your_firebase_web_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=replace_with_app_id

# Android Maps SDK key. It is injected into the native Android manifest at build time.
# This client key is visible in the APK: restrict it to this Android package,
# the relevant signing SHA-1 fingerprints, and Maps SDK for Android only.
GOOGLE_MAPS_ANDROID_API_KEY=

