{
  "expo": {
    "name": "MyTruck Delivery",
    "slug": "ebhan",
    "owner": "mytruck",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MyTruck Delivery to use your location while the app is open to set a delivery location and, for drivers, share active delivery progress."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#179B83",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-image-picker"
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/optimized/splash.jpg",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0B2A26"
        }
      ],
      "./plugins/withMapsHardwareAcceleration",
      "./plugins/withWorkManagerR8Rules",
      "./plugins/withGradleBinDistribution"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mytruck.delivery",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B2A26"
      },
      "package": "com.mytruck.delivery",
      "versionCode": 14,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "firebase": {
        "apiKey": "AIzaSyC-nkTw6cAbjKwpb9asX0ogzp5Zrigna2E",
        "authDomain": "mytruck-1fa3f.firebaseapp.com",
        "projectId": "mytruck-1fa3f",
        "storageBucket": "mytruck-1fa3f.firebasestorage.app",
        "messagingSenderId": "876531962485",
        "appId": "1:876531962485:web:609b5d3a3f0a5c30a25e3c",
        "measurementId": "G-82N7CC7L0S"
      },
      "perfTimings": false,
      "eas": {
        "projectId": "4e3e9b4f-d20e-4fe5-badc-a8efbcdb7605"
      }
    }
  }
}
