{
  "expo": {
    "name": "MyTruck Delivery",
    "slug": "ebhan",
    "owner": "ebbanufs-team",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(MyTruck Delivery) to use your location."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#179B83",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-image-picker"
      ],
      "./plugins/withGradleBinDistribution"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B2A26"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mytruck.delivery",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B2A26"
      },
      "package": "com.mytruck.delivery",
      "versionCode": 9,
      "softwareKeyboardLayoutMode": "pan",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD4Gt0hyMYv6gSoGDxsiQLQdHSKk2CWw8A"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "googleMapsApiKey": "AIzaSyD4Gt0hyMYv6gSoGDxsiQLQdHSKk2CWw8A",
      "chapaSecretKey": "CHASECK-2wQU2SzPeV7V9Pu2Mdb9gxNY2k9Jq5nQ",
      "firebase": {
        "apiKey": "AIzaSyDwOvj_4-Oc-jwWpw1yoNm7frhoBJuZhSo",
