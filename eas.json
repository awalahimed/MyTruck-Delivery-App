{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "credentialsSource": "remote",
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NPM_FLAGS": "--legacy-peer-deps",
        "PERF_TIMINGS": "0",
        "MYTRUCK_ANDROID_ABIS": "arm64-v8a",
        "MYTRUCK_ANDROID_SHRINK_RESOURCES": "false",
        "MYTRUCK_ANDROID_COMPRESS_LIBS": "true"
      }
    },
    "ios-preview": {
      "credentialsSource": "remote",
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": true
      },
      "env": {
        "NPM_FLAGS": "--legacy-peer-deps"
      }
    },
    "production": {
      "credentialsSource": "remote",
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NPM_FLAGS": "--legacy-peer-deps",
        "PERF_TIMINGS": "1"
      }
    }
  }
}
